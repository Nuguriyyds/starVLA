# Fill these after creating the Alibaba Cloud four-node job.
# Apply the same plan/output/model/data mounts on all nodes.
export MASTER_ADDR=''  # Reachable private address of node 0.
export MASTER_PORT='29500'
export NODE_RANK=''    # Different on each node: 0,1,2,3. Do not guess from device rank.
export PLAN=''         # Final plan, not plan.template.yaml.
export RUN_DIR=''      # New private persistent run directory shared by all nodes.
export PYTHON_BIN=''   # Existing compatible PPU environment; no package installation here.
export PPU_ENV_SCRIPT='/usr/local/PPU_SDK/envsetup.sh'
# Platform-specific communication interface settings belong here when provided.
# Preserve the device range allocated by the cloud job; do not copy CUDA_VISIBLE_DEVICES=0.
# start_node.sh checks for at least 16 visible devices and never widens visibility automatically.
# RESUME=latest            # Resume the same run and unchanged plan on all four nodes.
# PAUSE_AFTER_UPDATE=...   # Optional planned pause at a completed global update.
